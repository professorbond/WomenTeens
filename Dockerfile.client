# ═══════════════════════════════════════════════════════════════════
#  PeakGuard Client — React (Vite) multi-stage Dockerfile
# ═══════════════════════════════════════════════════════════════════

# ── Stage 1: Build ────────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

COPY peakguard-client/package.json peakguard-client/package-lock.json ./
RUN npm ci

COPY peakguard-client/ .
RUN npm run build

# ── Stage 2: Serve with nginx ────────────────────────────────────
FROM nginx:alpine AS runtime

# Кастомный nginx конфиг для SPA (react-router)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Копируем собранный фронт
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
